{
  "name": "@deepseek-ai/dsh-vision-local",
  "version": "1.1.0",
  "description": "DSH vision bridge: native attachments for image-capable models, image_vision tool fallback for text-only models, plus drag/paste composer intake.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "node scripts/build.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "workspace:^"
  }
}

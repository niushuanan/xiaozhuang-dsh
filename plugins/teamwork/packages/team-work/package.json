{
  "name": "@deepseek-ai/dsh-team-work",
  "version": "1.4.0",
  "description": "Permanent Teamwork mode plugin with plan-first orchestration, a compact team panel, and Codex/Z Code collaborators.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-session-format": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session-format-catalog": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "workspace:^"
  }
}

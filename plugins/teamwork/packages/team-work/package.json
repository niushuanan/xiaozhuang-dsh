{
  "name": "@deepseek-ai/dsh-team-work",
  "version": "1.3.0",
  "description": "Permanent Teamwork mode plugin with plan-first orchestration, a compact team panel, and Codex/Z Code collaborators.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["sessions", "@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-session-format": "workspace:^",
    "zod": "^4.4.3"
  }
}

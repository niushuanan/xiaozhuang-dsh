{
  "name": "@deepseek-ai/dsh-token-overview",
  "version": "1.4.3",
  "description": "Whole-machine token overview with usage milestones, history insights and nonlinear hourly forecasts.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "bundle": "node scripts/build.mjs"
  },
  "engines": {
    "dsh": "^0.2.1-0"
  },
  "dependencies": {
    "ml-random-forest": "2.1.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}

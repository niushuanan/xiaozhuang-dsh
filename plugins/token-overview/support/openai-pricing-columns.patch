+        standard = False
+        headers = []
+        for line in document.splitlines():
+            text = line.strip()
+            if text == "Standard" or text.startswith("### Standard pricing data"):
+                standard = True
+                headers = []
+            elif text in {"Batch", "Flex/Batch", "Fast", "Ultrafast"} or re.match(r"### (Batch|Flex|Fast|Ultrafast) pricing data", text):
+                standard = False
+                headers = []
+            if not text.startswith("|"):
+                continue
+            cells = [c.strip().strip("*") for c in text.strip("|").split("|")]
+            lower = [c.lower() for c in cells]
+            if "model" in lower:
+                headers = lower
+                continue
+            if not standard or not headers or len(cells) != len(headers) or "training" in headers or "modality" in headers:
+                continue
+            model = cells[headers.index("model")].split(" (")[0]
+            if not re.match(r"^(gpt-|o[134])", model):
+                continue
+            def rates(prefix):
+                def value(*names):
+                    column = next((headers.index(prefix + name) for name in names if prefix + name in headers), None)
+                    return rate(cells[column]) if column is not None else None
+                return [value("input"), value("cached input"), value("30m write", "cache write"), value("output")]
+            prefix = "short context " if "short context input" in headers else ""
+            values = rates(prefix)
+            if values[0] is None or values[3] is None:
+                continue
+            current = row(model, "OpenAI", values, "标准短上下文" if prefix else "标准价")
+            if "long context input" in headers:
+                current["longContext"] = dict(zip(("input", "cacheRead", "cacheWrite", "output"), rates("long context ")))
+            rows.setdefault(model, current)
